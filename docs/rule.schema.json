{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kelvin78901/DealSeaking/docs/rule.schema.json",
  "title": "DealSeaking watch rule",
  "description": "A user's watch rule: what to watch (target), which offers qualify (conditions), which changes trigger (events), and how to deliver (delivery). Draft v0.2.",
  "type": "object",
  "required": ["name", "target", "events", "delivery"],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 80},
    "enabled": {"type": "boolean", "default": true},
    "target": {"$ref": "#/$defs/target"},
    "conditions": {"$ref": "#/$defs/conditions"},
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["new", "price_drop", "restock", "open_box_appears", "historical_low", "hot"]}
    },
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "$defs": {
    "target": {
      "description": "At least one selector. Exact identifiers (gtin, mpn, sku, url) beat fuzzy ones (keywords, regex).",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "category": {"type": "string", "pattern": "^[a-z0-9_]+(/[a-z0-9_]+)*$", "description": "Node in the unified taxonomy, e.g. storage/ssd/nvme. Matches the node and its children."},
        "brand": {"type": "string"},
        "gtin": {"type": "string", "pattern": "^[0-9]{8,14}$", "description": "UPC/EAN/GTIN"},
        "mpn": {"type": "string", "description": "Manufacturer part number; combine with brand."},
        "sku": {
          "type": "object",
          "required": ["source", "id"],
          "additionalProperties": false,
          "properties": {"source": {"$ref": "#/$defs/source"}, "id": {"type": "string"}}
        },
        "url": {"type": "string", "format": "uri", "description": "A product page the user pasted; canonicalized before storing."},
        "keywords": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "All must appear in the title (case-insensitive)."},
        "keywords_exclude": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "regex": {"type": "string", "maxLength": 200, "description": "Applied to the normalized title; run with a timeout."}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_price": {"type": "number", "exclusiveMinimum": 0, "description": "USD"},
        "min_discount_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "historical_low": {"type": "boolean", "description": "Price is at or below the lowest seen for this product."},
        "max_price_per_tb": {"type": "number", "exclusiveMinimum": 0, "description": "Storage categories only."},
        "min_capacity_gb": {"type": "number", "exclusiveMinimum": 0, "description": "Storage categories only."},
        "conditions_allowed": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["new", "open_box", "refurbished", "used"]}
        },
        "sources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
        "online": {"type": "boolean", "description": "Include online offers."},
        "store_radius_miles": {"type": "number", "minimum": 0, "description": "Include in-store offers within this distance of the user's ZIP."},
        "in_stock_only": {"type": "boolean", "default": true},
        "min_hot_score": {"type": "number", "minimum": 0},
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/conditions"},
          "description": "At least one of these sub-conditions must hold (OR). Sibling keys are ANDed."
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["mode", "channels"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["instant", "daily_digest", "weekly_digest"], "description": "instant requires a Pro plan."},
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["email", "web_push", "telegram", "discord", "ntfy"]}
        },
        "cooldown_hours": {"type": "number", "minimum": 0, "default": 24, "description": "Don't alert the same product + event again within this window."},
        "quiet_hours": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
          "description": "[start, end] in the user's time zone; may wrap midnight."
        },
        "else": {"enum": ["daily_digest", "weekly_digest", "none"], "default": "none", "description": "Where matches go when instant delivery is suppressed (quiet hours, cooldown, quota)."},
        "max_per_day": {"type": "integer", "minimum": 1}
      }
    },
    "source": {"enum": ["microcenter", "bestbuy", "woot", "ebay", "walmart", "amazon", "dealnews", "slickdeals"]}
  }
}
